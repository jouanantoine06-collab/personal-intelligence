# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (AI Provider)
ANTHROPIC_API_KEY=

# URL de base de l'application (pour construire les redirect_uri OAuth) —
# http://localhost:3000 en dev, l'URL Vercel réelle en production.
APP_URL=

# Google OAuth (Calendar) — V1.3a
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Clé de chiffrement des tokens OAuth stockés (AES-256-GCM), 32 octets en
# base64. Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Distincte des clés Supabase et Google — jamais partagée entre environnements.
OAUTH_TOKEN_ENCRYPTION_KEY=
